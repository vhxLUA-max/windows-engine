{
  "manifest_version": 3,
  "name": "Cheezie Engine Live Bridge",
  "version": "1.0.0",
  "description": "Reads the current Chess.com position and sends it to Cheezie Engine.",
  "permissions": ["nativeMessaging"],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "https://*.chess.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://*.chess.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge.js"],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://*.chess.com/*"
      ]
    }
  ],
  "key": ""
}
